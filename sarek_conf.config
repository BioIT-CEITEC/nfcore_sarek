process {
    withName: 'NFCORE_SAREK:SAREK:BAM_VARIANT_CALLING_SOMATIC_ALL:BAM_VARIANT_CALLING_FREEBAYES:FREEBAYES' {
        ext.args = '--pooled-continuous --pooled-discrete --genotype-qualities --report-genotype-likelihood-max --allele-balance-priors-off --min-alternate-fraction 0.03 --min-repeat-entropy 1 --min-alternate-count 2 --strict-vcf'
    }

    withName: 'VCFS_NORM' {
        ext.prefix = { vcf.baseName - '.added_info.vcf' + '.norm' }
        ext.args = { [
            '--multiallelics -both', // split multiallelic sites into biallelic records and both SNPs and indels should be merged separately into two records
            '--rm-dup exact'           // output only the first instance of a record which is present multiple times
        ].join(' ') }
        publishDir = [
            enabled: false
        ]
    }
}
  