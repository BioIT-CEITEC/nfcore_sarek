k8s {
   namespace = 'sequia-ns'
   pod = [ [volumeClaim: 'pvc-713003-pospisilova-base', mountPath: '/storage3' ]]
   runAsUser = 1000
   storageClaimName = 'pvc-scratch'
   storageMountPath = '/scratch'
   workDir = '/mnt/data/scratch/temp'
   launchDir = '/mnt/data/scratch/launch'
   projectDir = '/mnt/data/scratch/project'
   pullPolicy = 'Always'
}

executor {
   queueSize = 20
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    scratch = true
    executor = 'k8s'
    errorStrategy = { task.exitStatus in [1] ?  'finish' : 'retry' }
    cpus = 1
    memory = '1GB'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [143,137,104,134,139,247] ? 'retry' : 'finish' }
    maxRetries = 5

   withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        cpus   = { 24 }
        memory = { 30.GB * task.attempt }
    }
   withName: 'FREEBAYES' {
        memory = { 20.GB * task.attempt }
    }
    withName: 'VCFTOOLS_TSTV_QUAL' {
        memory = { 6.GB * task.attempt }
    }
}
